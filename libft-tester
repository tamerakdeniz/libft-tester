#!/usr/bin/env python3
import argparse
import json
import os
import platform
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import asdict, dataclass
from pathlib import Path
from typing import List, Optional


ROOT = Path(__file__).resolve().parent
HARNESS_SOURCE = ROOT / "src" / "libft_test_harness.c"

MANDATORY_FUNCTIONS = {
    "ft_isalpha", "ft_isdigit", "ft_isalnum", "ft_isascii", "ft_isprint",
    "ft_strlen", "ft_memset", "ft_bzero", "ft_memcpy", "ft_memmove",
    "ft_strlcpy", "ft_strlcat", "ft_toupper", "ft_tolower", "ft_strchr",
    "ft_strrchr", "ft_strncmp", "ft_memchr", "ft_memcmp", "ft_strnstr",
    "ft_atoi", "ft_calloc", "ft_strdup", "ft_substr", "ft_strjoin",
    "ft_strtrim", "ft_split", "ft_itoa", "ft_strmapi", "ft_striteri",
    "ft_putchar_fd", "ft_putstr_fd", "ft_putendl_fd", "ft_putnbr_fd",
    "ft_lstnew", "ft_lstadd_front", "ft_lstsize", "ft_lstlast",
    "ft_lstadd_back", "ft_lstdelone", "ft_lstclear", "ft_lstiter",
    "ft_lstmap",
}

BONUS_FUNCTIONS = set()
UPDATE_CHECK_TIMEOUT = 2.0


class Color:
    def __init__(self, enabled: bool):
        self.enabled = enabled

    def wrap(self, text: str, code: str) -> str:
        if not self.enabled:
            return text
        return f"\033[{code}m{text}\033[0m"

    def red(self, text: str) -> str:
        return self.wrap(text, "31;1")

    def green(self, text: str) -> str:
        return self.wrap(text, "32;1")

    def yellow(self, text: str) -> str:
        return self.wrap(text, "33;1")

    def blue(self, text: str) -> str:
        return self.wrap(text, "34;1")

    def dim(self, text: str) -> str:
        return self.wrap(text, "2")


@dataclass
class HarnessTest:
    test_id: str
    function: str
    group: str
    kind: str
    description: str


@dataclass
class TestResult:
    test_id: str
    function: str
    group: str
    kind: str
    description: str
    phase: str
    status: str
    exit_code: Optional[int]
    signal: Optional[str]
    duration_ms: int
    output: str


class TesterError(Exception):
    pass


def run_command(cmd, cwd=None, timeout=30, env=None):
    try:
        return subprocess.run(
            cmd,
            cwd=cwd,
            env=env,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode(errors="replace")
        raise TesterError(
            f"Command timed out after {timeout}s: {' '.join(map(str, cmd))}\n{output}"
        )
    except FileNotFoundError as exc:
        raise TesterError(f"Command not found: {exc.filename}")


def run_quiet(cmd, timeout=UPDATE_CHECK_TIMEOUT):
    try:
        return subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        return None


def git_cmd(*args, timeout=UPDATE_CHECK_TIMEOUT):
    return run_quiet(["git", "-C", str(ROOT), *args], timeout=timeout)


def is_git_checkout():
    result = git_cmd("rev-parse", "--is-inside-work-tree")
    return result is not None and result.returncode == 0


def local_git_head():
    result = git_cmd("rev-parse", "HEAD")
    if result is None or result.returncode != 0:
        return None
    return result.stdout.strip()


def remote_git_head():
    result = git_cmd("ls-remote", "--symref", "origin", "HEAD")
    if result is None or result.returncode != 0:
        return None
    for line in result.stdout.splitlines():
        parts = line.split()
        if len(parts) == 2 and parts[1] == "HEAD" and len(parts[0]) >= 7:
            return parts[0]
    return None


def remote_head_is_ancestor(remote_head):
    result = git_cmd("merge-base", "--is-ancestor", remote_head, "HEAD")
    return result is not None and result.returncode == 0


def check_for_updates(color: Color):
    if not is_git_checkout():
        return
    local_head = local_git_head()
    remote_head = remote_git_head()
    if not local_head or not remote_head or local_head == remote_head:
        return
    if remote_head_is_ancestor(remote_head):
        return
    local_short = local_head[:7]
    remote_short = remote_head[:7]
    print(
        color.yellow("Update available: ")
        + f"local {local_short}, remote {remote_short}. "
        + "Run `libft-tester --update`."
    )


def run_self_update(color: Color):
    if not is_git_checkout():
        print(
            color.red(
                "This libft-tester installation is not a git checkout. "
                "Re-clone the repository to update it."
            ),
            file=sys.stderr,
        )
        return 2
    status = git_cmd("status", "--porcelain", timeout=5)
    if status is None or status.returncode != 0:
        print(color.red("Could not inspect the tester git status."), file=sys.stderr)
        return 2
    if status.stdout.strip():
        print(
            color.red(
                "Refusing to update because the tester checkout has local changes."
            ),
            file=sys.stderr,
        )
        print("Commit, stash, or discard those changes first.", file=sys.stderr)
        return 2
    print(color.blue("==> Updating libft-tester"))
    result = run_command(["git", "-C", str(ROOT), "pull", "--ff-only"], timeout=60)
    if result.stdout.strip():
        print(result.stdout.rstrip())
    if result.returncode != 0:
        print(color.red("Update failed."), file=sys.stderr)
        return 2
    print(color.green("libft-tester is up to date."))
    return 0


def copy_project(source: Path, destination: Path):
    ignored_names = {
        ".git", ".cache", ".idea", ".vscode", ".DS_Store",
        "libft.a", "a.out",
    }

    def ignore(_dir, names):
        ignored = set()
        for name in names:
            if name in ignored_names:
                ignored.add(name)
            elif name.endswith((".o", ".d", ".gcda", ".gcno", ".gcov")):
                ignored.add(name)
        return ignored

    shutil.copytree(source, destination, ignore=ignore)


def choose_groups(args):
    if args.all:
        return {"mandatory", "bonus"}
    if args.bonus and args.mandatory:
        return {"mandatory", "bonus"}
    if args.bonus:
        return {"bonus"}
    return {"mandatory"}


def parse_only(values):
    selected = set()
    for value in values or []:
        for item in value.split(","):
            item = item.strip()
            if item:
                selected.add(item)
    return selected


def build_target(project_dir: Path, include_bonus: bool, verbose: bool, make_vars=None):
    make_vars = make_vars or []
    makefile = project_dir / "Makefile"
    if not makefile.exists():
        raise TesterError(f"No Makefile found in copied project: {project_dir}")
    fclean = run_command(["make", "-C", str(project_dir), "fclean"], timeout=60)
    if verbose and fclean.stdout.strip():
        print(fclean.stdout.rstrip())
    if fclean.returncode != 0:
        raise TesterError("make fclean failed:\n" + fclean.stdout)
    build = run_command(["make", "-C", str(project_dir), *make_vars, "all"], timeout=120)
    if verbose and build.stdout.strip():
        print(build.stdout.rstrip())
    if build.returncode != 0:
        raise TesterError("make all failed:\n" + build.stdout)
    if include_bonus and BONUS_FUNCTIONS:
        bonus = run_command(["make", "-C", str(project_dir), *make_vars, "bonus"], timeout=120)
        if verbose and bonus.stdout.strip():
            print(bonus.stdout.rstrip())
        if bonus.returncode != 0:
            raise TesterError("make bonus failed:\n" + bonus.stdout)


def find_libft(project_dir: Path):
    root_lib = project_dir / "libft.a"
    if root_lib.exists():
        return root_lib, None
    matches = list(project_dir.rglob("libft.a"))
    if not matches:
        raise TesterError("Build completed, but libft.a was not found.")
    warning = (
        "libft.a was not created at the project root. "
        f"Using discovered archive: {matches[0]}"
    )
    return matches[0], warning


def exported_symbols(libft: Path):
    result = run_command(["nm", "-g", str(libft)], timeout=30)
    if result.returncode != 0:
        raise TesterError("nm failed while inspecting libft.a:\n" + result.stdout)
    symbols = set()
    for line in result.stdout.splitlines():
        for token in line.strip().split():
            if token.startswith("_ft_"):
                symbols.add(token[1:])
            elif token.startswith("ft_"):
                symbols.add(token)
    return symbols


def whole_archive_flags(libft: Path):
    if platform.system() == "Darwin":
        return [f"-Wl,-force_load,{libft}"]
    return ["-Wl,--whole-archive", str(libft), "-Wl,--no-whole-archive"]


def compile_harness(libft: Path, output: Path, asan=False, disable_alloc_wrap=False):
    if not HARNESS_SOURCE.exists():
        raise TesterError(f"Harness source missing: {HARNESS_SOURCE}")
    cmd = ["cc", "-Wall", "-Wextra", "-Werror", "-g", "-O0"]
    if asan:
        cmd += ["-fsanitize=address,undefined", "-fno-omit-frame-pointer"]
    if disable_alloc_wrap:
        cmd += ["-DLT_DISABLE_ALLOC_WRAP=1"]
    cmd += [str(HARNESS_SOURCE)]
    cmd += whole_archive_flags(libft)
    cmd += ["-o", str(output)]
    if platform.system() != "Darwin":
        cmd += ["-ldl"]
    result = run_command(cmd, timeout=120)
    if result.returncode != 0:
        raise TesterError("Harness compilation failed:\n" + result.stdout)


def load_tests(harness: Path):
    result = run_command([str(harness), "--list"], timeout=10)
    if result.returncode != 0:
        raise TesterError("Could not list harness tests:\n" + result.stdout)
    tests = []
    for line in result.stdout.splitlines():
        parts = line.split("\t", 4)
        if len(parts) == 5:
            tests.append(HarnessTest(*parts))
    return tests


def signal_name(returncode):
    if returncode is None or returncode >= 0:
        return None
    signum = -returncode
    try:
        return signal.Signals(signum).name
    except ValueError:
        return f"SIG{signum}"


def classify_result(test, phase, returncode, output, duration_ms, timed_out=False):
    if timed_out:
        status = "timeout"
        sig = None
    elif returncode == 0:
        status = "pass"
        sig = None
    elif returncode == 2:
        status = "missing"
        sig = None
    elif returncode == 3:
        status = "skip"
        sig = None
    elif returncode is not None and returncode < 0:
        status = "crash"
        sig = signal_name(returncode)
    elif returncode == 97 and phase == "valgrind":
        status = "leak"
        sig = None
    else:
        status = "fail"
        sig = None
    if test.kind == "probe" and status not in {"pass", "skip"}:
        status = "warn"
    return TestResult(
        test.test_id,
        test.function,
        test.group,
        test.kind,
        test.description,
        phase,
        status,
        returncode,
        sig,
        duration_ms,
        output.strip(),
    )


def run_one(harness: Path, test: HarnessTest, timeout: float, phase="functional",
            command_prefix=None, env=None):
    cmd = []
    if command_prefix:
        cmd.extend(command_prefix)
    cmd += [str(harness), "--run", test.test_id]
    started = time.monotonic()
    try:
        proc = subprocess.run(
            cmd,
            text=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            timeout=timeout,
            env=env,
        )
        duration_ms = int((time.monotonic() - started) * 1000)
        return classify_result(
            test, phase, proc.returncode, proc.stdout, duration_ms
        )
    except subprocess.TimeoutExpired as exc:
        duration_ms = int((time.monotonic() - started) * 1000)
        output = exc.stdout or ""
        if isinstance(output, bytes):
            output = output.decode(errors="replace")
        return classify_result(
            test, phase, None, output, duration_ms, timed_out=True
        )


def format_status(color: Color, status: str):
    labels = {
        "pass": ("PASS", color.green),
        "fail": ("FAIL", color.red),
        "missing": ("MISS", color.red),
        "crash": ("CRASH", color.red),
        "timeout": ("TIMEOUT", color.red),
        "warn": ("WARN", color.yellow),
        "skip": ("SKIP", color.yellow),
        "leak": ("LEAK", color.red),
    }
    text, painter = labels.get(status, (status.upper(), lambda value: value))
    return painter(f"{text:<7}")


def print_section(color: Color, title: str):
    print()
    print(color.blue(title))
    print(color.dim("-" * len(title)))


def display_memory_mode(mode):
    names = {
        "asan": "ASan",
        "valgrind": "Valgrind",
    }
    return names.get(mode, mode if mode else "off")


def print_run_header(color: Color, project: Path, groups, only, args, mode):
    selected = ", ".join(sorted(groups))
    filters = ", ".join(sorted(only)) if only else "none"
    memory = display_memory_mode(mode)

    print(color.blue("libft-tester"))
    print(f"Project : {project}")
    print(f"Subject : Libft v19.3")
    print(f"Mode    : {selected}")
    print(f"Only    : {filters}")
    print(f"Timeout : {args.timeout:g}s")
    print(f"Memory  : {memory}")


def print_result(color: Color, result: TestResult, verbose: bool,
                 index: int, total: int):
    label = format_status(color, result.status)
    counter = f"[{index:03d}/{total:03d}]"
    duration = f"{result.duration_ms:>5} ms"
    sig = f"  {color.red(result.signal)}" if result.signal else ""
    detail = color.dim(result.description)
    print(
        f"{counter} {label} {result.test_id:<34} {duration}  "
        f"{detail}{sig}"
    )
    if result.output and (verbose or result.status not in {"pass", "skip"}):
        for line in result.output.splitlines()[-12:]:
            print("  " + line)


def selected_tests(all_tests, groups, only):
    tests = [test for test in all_tests if test.group in groups]
    if only:
        tests = [
            test for test in tests
            if test.function in only or test.test_id in only
        ]
    return tests


def valgrind_prefix():
    valgrind = shutil.which("valgrind")
    if not valgrind:
        return None
    return [
        valgrind,
        "--quiet",
        "--leak-check=full",
        "--show-leak-kinds=definite,indirect,possible",
        "--errors-for-leak-kinds=definite,indirect,possible",
        "--error-exitcode=97",
    ]


def memory_mode(args):
    if args.valgrind:
        if platform.system() == "Darwin" and not valgrind_prefix():
            return "asan"
        return "valgrind"
    if args.asan:
        return "asan"
    if args.leaks:
        return "valgrind" if valgrind_prefix() else "asan"
    return None


def asan_options():
    leak_flag = "detect_leaks=0" if platform.system() == "Darwin" else "detect_leaks=1"
    return (
        f"{leak_flag}:halt_on_error=1:abort_on_error=1:"
        "allocator_may_return_null=1"
    )


def memory_mode_warning(args, mode):
    if mode != "asan" or platform.system() != "Darwin":
        return None
    if args.valgrind and not valgrind_prefix():
        return (
            "Valgrind was requested but was not found. On macOS, "
            "libft-tester is using ASan/UBSan instead. Apple's ASan does not "
            "support LeakSanitizer here, so this is not a strict leak check."
        )
    if args.leaks and not valgrind_prefix():
        return (
            "Valgrind was not found. macOS AddressSanitizer does not "
            "support LeakSanitizer here, so --leaks is running ASan/UBSan "
            "diagnostics without leak detection."
        )
    return None


def strict_failure(result: TestResult):
    if result.kind == "probe":
        return False
    return result.status not in {"pass", "skip"}


def write_json_report(path: Path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload, indent=2), encoding="utf-8")


def main():
    parser = argparse.ArgumentParser(
        description="Portable 42 Libft tester with isolated crash-safe tests."
    )
    parser.add_argument("project", nargs="?",
                        help="Path to the Libft project to test")
    parser.add_argument("--update", action="store_true",
                        help="Update this tester checkout with git pull --ff-only.")
    parser.add_argument("--no-update-check", action="store_true",
                        help="Do not check GitHub for a newer tester version.")
    parser.add_argument("--mandatory", action="store_true",
                        help="Run mandatory tests. This is the default.")
    parser.add_argument("--bonus", action="store_true",
                        help="Run subject bonus tests when configured.")
    parser.add_argument("--all", action="store_true",
                        help="Run mandatory and bonus tests.")
    parser.add_argument("--leaks", action="store_true",
                        help="Smart memory check: Valgrind when available, otherwise ASan.")
    parser.add_argument("--asan", action="store_true",
                        help="Run an AddressSanitizer/UBSan memory pass. Recommended on macOS.")
    parser.add_argument("--valgrind", action="store_true",
                        help="Run Valgrind. On macOS without Valgrind, falls back to ASan.")
    parser.add_argument("--verbose", action="store_true",
                        help="Print build logs and passing test output.")
    parser.add_argument("--only", action="append",
                        help="Run only a function or test id. Can be repeated or comma separated.")
    parser.add_argument("--json", dest="json_path",
                        help="Write a JSON report to the given path.")
    parser.add_argument("--timeout", type=float, default=2.0,
                        help="Per-test timeout in seconds. Default: 2.0")
    parser.add_argument("--keep-tmp", action="store_true",
                        help="Keep the temporary build directory.")
    parser.add_argument("--no-color", action="store_true",
                        help="Disable ANSI colors.")
    args = parser.parse_args()

    color = Color(sys.stdout.isatty() and not args.no_color)
    if args.update:
        return run_self_update(color)
    if args.project is None:
        parser.error("the following arguments are required: project")
    if (
        not args.no_update_check
        and os.environ.get("LIBFT_TESTER_NO_UPDATE_CHECK") != "1"
        and sys.stdout.isatty()
    ):
        check_for_updates(color)
    project = Path(args.project).expanduser().resolve()
    if not project.exists() or not project.is_dir():
        print(color.red(f"Invalid project directory: {project}"), file=sys.stderr)
        return 2

    groups = choose_groups(args)
    only = parse_only(args.only)
    mode = memory_mode(args)
    if groups == {"bonus"} and not BONUS_FUNCTIONS:
        print(color.yellow("No bonus tests are configured for Libft subject v19.3."))
        payload = {
            "project": str(project),
            "subject": "Libft v19.3",
            "results": [],
            "summary": {"total": 0, "failed": 0},
        }
        if args.json_path:
            write_json_report(Path(args.json_path), payload)
        return 0

    tmp_root = Path(tempfile.mkdtemp(prefix="libft-tester-"))
    results: List[TestResult] = []
    warnings = []
    exit_code = 0

    try:
        print_run_header(color, project, groups, only, args, mode)
        copied_project = tmp_root / "project"
        copy_project(project, copied_project)
        print_section(color, "Build")
        print("Compiling a temporary copy of the submitted project.")
        build_target(copied_project, "bonus" in groups, args.verbose)
        libft, warning = find_libft(copied_project)
        if warning:
            warnings.append(warning)
            print(color.yellow("Warning: ") + warning)
        symbols = exported_symbols(libft)
        test_env = os.environ.copy()
        test_env["LT_AVAILABLE_SYMBOLS"] = ";".join(sorted(symbols))

        harness = tmp_root / "libft_harness"
        compile_harness(libft, harness)
        all_tests = load_tests(harness)
        tests = selected_tests(all_tests, groups, only)

        if not tests:
            if only:
                selected = ", ".join(sorted(only))
                print(
                    color.red("No tests matched --only filter: ")
                    + selected,
                    file=sys.stderr,
                )
                return 2
            print(color.yellow("No tests matched the selected mode/filter."))
            return 0

        print_section(color, "Functional Tests")
        print(f"Count: {len(tests)}")
        for index, test in enumerate(tests, 1):
            result = run_one(harness, test, args.timeout, env=test_env)
            results.append(result)
            print_result(color, result, args.verbose, index, len(tests))

        if mode:
            warning = memory_mode_warning(args, mode)
            if warning:
                warnings.append(warning)
                print(color.yellow("Warning: ") + warning)
            memory_tests = [
                test for test in tests
                if test.kind not in {"probe", "allocfail"}
            ]
            if memory_tests:
                mem_libft = libft
                mem_env = test_env.copy()
                if mode == "asan":
                    asan_project = tmp_root / "project_asan"
                    copy_project(project, asan_project)
                    asan_flags = (
                        "-Wall -Wextra -Werror -g -O0 "
                        "-fsanitize=address,undefined -fno-omit-frame-pointer"
                    )
                    print_section(color, "ASan Build")
                    print("Compiling a second temporary copy with sanitizer flags.")
                    build_target(
                        asan_project,
                        "bonus" in groups,
                        args.verbose,
                        make_vars=["CC=cc", f"CFLAGS={asan_flags}"],
                    )
                    mem_libft, mem_warning = find_libft(asan_project)
                    if mem_warning:
                        warnings.append(mem_warning)
                        print(color.yellow("Warning: ") + mem_warning)
                    mem_symbols = exported_symbols(mem_libft)
                    mem_env["LT_AVAILABLE_SYMBOLS"] = ";".join(sorted(mem_symbols))
                mem_harness = tmp_root / f"libft_harness_{mode}"
                compile_harness(
                    mem_libft,
                    mem_harness,
                    asan=(mode == "asan"),
                    disable_alloc_wrap=True,
                )
                if mode == "valgrind":
                    prefix = valgrind_prefix()
                    if not prefix:
                        raise TesterError("Valgrind was requested but was not found in PATH.")
                    env = mem_env.copy()
                else:
                    prefix = None
                    env = mem_env.copy()
                    env["ASAN_OPTIONS"] = asan_options()
                    env["UBSAN_OPTIONS"] = "halt_on_error=1:abort_on_error=1"
                title = f"{display_memory_mode(mode)} Memory Tests"
                print_section(color, title)
                print(f"Count: {len(memory_tests)}")
                for index, test in enumerate(memory_tests, 1):
                    result = run_one(
                        mem_harness,
                        test,
                        max(args.timeout * 10, 10),
                        phase=mode,
                        command_prefix=prefix,
                        env=env,
                    )
                    results.append(result)
                    print_result(color, result, args.verbose, index, len(memory_tests))

        failed = [result for result in results if strict_failure(result)]
        warned = [result for result in results if result.status == "warn"]
        passed = [result for result in results if result.status == "pass"]
        skipped = [result for result in results if result.status == "skip"]

        print_section(color, "Summary")
        print(f"{'Passed':<10} {len(passed)}")
        print(f"{'Failed':<10} {len(failed)}")
        print(f"{'Warnings':<10} {len(warned)}")
        print(f"{'Skipped':<10} {len(skipped)}")
        if failed:
            exit_code = 1
            print()
            print(color.red("Failing required tests:"))
            for result in failed[:20]:
                sig = f" ({result.signal})" if result.signal else ""
                print(f"  - {result.test_id}: {result.status}{sig}")
            if len(failed) > 20:
                print(f"  ... and {len(failed) - 20} more")
        elif warned:
            print(color.yellow("Required tests passed. Probe warnings do not affect exit code."))
        else:
            print(color.green("All required tests passed."))

    except TesterError as exc:
        print(color.red(str(exc)), file=sys.stderr)
        exit_code = 2
    finally:
        payload = {
            "project": str(project),
            "subject": "Libft v19.3",
            "temporary_directory": str(tmp_root),
            "kept_temporary_directory": args.keep_tmp,
            "warnings": warnings,
            "results": [asdict(result) for result in results],
            "summary": {
                "total": len(results),
                "failed": len([r for r in results if strict_failure(r)]),
                "warnings": len([r for r in results if r.status == "warn"]),
            },
        }
        if args.json_path:
            write_json_report(Path(args.json_path), payload)
            print(f"JSON report: {Path(args.json_path).resolve()}")
        if args.keep_tmp:
            print(f"Temporary directory kept: {tmp_root}")
        else:
            shutil.rmtree(tmp_root, ignore_errors=True)
    return exit_code


if __name__ == "__main__":
    raise SystemExit(main())
